09:14:22.000+02:00"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="3"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_DOORS_AD-ForeignID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Mechanical interface"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_DOORS_AD-Chapter</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>_DOORS_OT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="_DOORS_obj-4" LAST-CHANGE="2026-09-30T09:14:22.000+02:00"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="4"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_DOORS_AD-ForeignID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>_DOORS_AD-Text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>The satellite <reqif-xhtml:b>shall</reqif-xhtml:b> mate to the 15-inch separation system provided by the launch service.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML><ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_DOORS_AD-Status</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>_DOORS_EV-Status-1</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION><ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_DOORS_AD-Verification</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>_DOORS_EV-Verification-0</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION><ATTRIBUTE-VALUE-DATE THE-VALUE="2026-05-12T10:00:00.000+02:00"><DEFINITION><ATTRIBUTE-DEFINITION-DATE-REF>_DOORS_AD-Created</ATTRIBUTE-DEFINITION-DATE-REF></DEFINITION></ATTRIBUTE-VALUE-DATE></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>_DOORS_OT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="_DOORS_obj-5" LAST-CHANGE="2026-09-30T09:14:22.000+02:00"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="5"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_DOORS_AD-ForeignID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>_DOORS_AD-Text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>The satellite centre of mass <reqif-xhtml:b>shall</reqif-xhtml:b> lie within 25 mm of the separation axis.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML><ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_DOORS_AD-Status</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>_DOORS_EV-Status-1</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION><ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_DOORS_AD-Verification</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>_DOORS_EV-Verification-0</ENUM-VALUE-REF><ENUM-VALUE-REF>_DOORS_EV-Verification-1</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION><ATTRIBUTE-VALUE-DATE THE-VALUE="2026-05-12T10:00:00.000+02:00"><DEFINITION><ATTRIBUTE-DEFINITION-DATE-REF>_DOORS_AD-Created</ATTRIBUTE-DEFINITION-DATE-REF></DEFINITION></ATTRIBUTE-VALUE-DATE></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>_DOORS_OT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="_DOORS_obj-6" LAST-CHANGE="2026-09-30T09:14:22.000+02:00"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="6"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_DOORS_AD-ForeignID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>_DOORS_AD-Text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>The first lateral natural frequency <reqif-xhtml:b>shall</reqif-xhtml:b> be above 25 Hz with the satellite hard-mounted.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML><ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_DOORS_AD-Status</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>_DOORS_EV-Status-1</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION><ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_DOORS_AD-Verification</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>_DOORS_EV-Verification-0</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION><ATTRIBUTE-VALUE-DATE THE-VALUE="2026-05-12T10:00:00.000+02:00"><DEFINITION><ATTRIBUTE-DEFINITION-DATE-REF>_DOORS_AD-Created</ATTRIBUTE-DEFINITION-DATE-REF></DEFINITION></ATTRIBUTE-VALUE-DATE></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>_DOORS_OT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="_DOORS_obj-7" LAST-CHANGE="2026-09-30T09:14:22.000+02:00"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="7"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_DOORS_AD-ForeignID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>_DOORS_AD-Text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>The first axial natural frequency <reqif-xhtml:b>shall</reqif-xhtml:b> be above 45 Hz with the satellite hard-mounted.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML><ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_DOORS_AD-Status</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>_DOORS_EV-Status-1</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION><ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_DOORS_AD-Verification</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>_DOORS_EV-Verification-0</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION><ATTRIBUTE-VALUE-DATE THE-VALUE="2026-05-12T10:00:00.000+02:00"><DEFINITION><ATTRIBUTE-DEFINITION-DATE-REF>_DOORS_AD-Created</ATTRIBUTE-DEFINITION-DATE-REF></DEFINITION></ATTRIBUTE-VALUE-DATE></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>_DOORS_OT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="_DOORS_obj-8" LAST-CHANGE="2026-09-30T09:14:22.000+02:00"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="8"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_DOORS_AD-ForeignID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Environment"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_DOORS_AD-Chapter</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>_DOORS_OT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="_DOORS_obj-9" LAST-CHANGE="2026-09-30T09:14:22.000+02:00"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="9"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_DOORS_AD-ForeignID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Mechanical environment"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_DOORS_AD-Chapter</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>_DOORS_OT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="_DOORS_obj-10" LAST-CHANGE="2026-09-30T09:14:22.000+02:00"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="10"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_DOORS_AD-ForeignID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>_DOORS_AD-Text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>The satellite <reqif-xhtml:b>shall</reqif-xhtml:b> withstand quasi-static loads of 8.5 g axial and 3.0 g lateral.</reqif-xhtml:p><reqif-xhtml:p>Loads are applied together, at the satellite centre of mass.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML><ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_DOORS_AD-Status</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>_DOORS_EV-Status-1</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION><ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_DOORS_AD-Verification</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>_DOORS_EV-Verification-1</ENUM-VALUE-REF><ENUM-VALUE-REF>_DOORS_EV-Verification-0</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION><ATTRIBUTE-VALUE-DATE THE-VALUE="2026-05-12T10:00:00.000+02:00"><DEFINITION><ATTRIBUTE-DEFINITION-DATE-REF>_DOORS_AD-Created</ATTRIBUTE-DEFINITION-DATE-REF></DEFINITION></ATTRIBUTE-VALUE-DATE></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>_DOORS_OT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="_DOORS_obj-11" LAST-CHANGE="2026-09-30T09:14:22.000+02:00"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="11"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>_DOORS_AD-ForeignID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>_DOORS_AD-Text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>The satellite <reqif-xhtml:b>shall</reqif-xhtml:b> withstand random vibration of 14.1 g rms, 20 to 2,000 Hz, 2 minutes per axis.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML><ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_DOORS_AD-Status</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>_DOORS_EV-Status-1</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION><ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>_DOORS_AD-Verification</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>_DOORS_EV-Verification-0</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION><ATTRIBUTE-VALUE-DATE THE-VALUE="2026-05-12T10:00:00.000+02:00"><D