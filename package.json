{
  "name": "open-requirements",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "npm run build -w @app/web",
    "db:up": "docker compose -f deploy/docker-compose.yml up -d db",
    "db:generate": "npm exec -w @app/server -- drizzle-kit generate",
    "dev:server": "DATABASE_URL=postgres://app:app@localhost:5432/app node --watch apps/server/src/main.ts",
    "dev:web": "npm run dev -w @app/web",
    "up": "docker compose -f deploy/docker-compose.yml up -d --build",
    "openapi": "UPDATE_OPENAPI=1 vitest run apps/server/src/integrations.test.ts -t OpenAPI",
    "demo": "node scripts/demo/spacecraft.ts",
    "samples:import": "node scripts/samples/make-import-samples.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.4"
  },
  "license": "AGPL-3.0-only"
}
